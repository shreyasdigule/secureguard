# ==============================================================================
# SecureGuard Governance Model (SGGM) — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Identity Provider / Keycloak Authentication ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=secureguard
KEYCLOAK_CLIENT_ID=secureguard-dashboard
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# --- Security Governance & Dual-Control Gates ---
# Window in seconds for MFA challenge freshness (default: 300)
SECUREGUARD_MFA_FRESHNESS=300

# Maximum token age in seconds before re-authentication is required (default: 900)
SECUREGUARD_TOKEN_MAX_AGE=900

# Require two supervisor approvals for critical actions (0 = disabled, 1 = enabled)
SECUREGUARD_DUAL_CONTROL=1

# Startup profile: "production" (strict verification) or "demo" (mock fallback)
SECUREGUARD_STARTUP_PROFILE=production

# Storage path for SQLite databases and cryptographic audit ledger
# Defaults to repository root or system appdata
# SECUREGUARD_DATA_DIR=/var/lib/secureguard

# --- Engine & Telemetry Tuning ---
# Timeout for pipeline command processing in seconds (default: 900.0)
SG_PIPELINE_TIMEOUT=900.0

# Timeout for telemetry streaming in seconds (default: 300.0)
SG_TELEMETRY_TIMEOUT=300.0

# View 3D animation target frame rate (default: 30.0 fps)
SG_VIEW3D_FPS=30.0

# Chart trend refresh rate in milliseconds (default: 30000 ms)
SG_CHART_REFRESH_MS=30000

# Live stream refresh interval in milliseconds (default: 2000 ms)
SG_STREAM_REFRESH_MS=2000

# Heartbeat interval in milliseconds (default: 1000 ms)
SG_HEARTBEAT_MS=1000

# Clock update interval in milliseconds (default: 1000 ms)
SG_CLOCK_MS=1000

# --- Headless / Display Configuration ---
# Set to 'offscreen' for headless CI/CD testing
# QT_QPA_PLATFORM=offscreen
PYQTGRAPH_QT_LIB=PySide6
