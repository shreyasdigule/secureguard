# Archive legacy files — deliberately non-compliant; ignore all then re-include tracked ones.
# Every re-include below is load-bearing: 9 of these files were deleted from the working
# tree on the belief that git could restore them. Only 2 were tracked, so the other 9
# were unrecoverable. Keep this list in sync with archive/deprecated/ contents.
archive/*
!archive/deprecated/
archive/deprecated/*
!archive/deprecated/ui_constants.py
!archive/deprecated/ui_constants_legacy_pyqt6.py
!archive/deprecated/check_status.py
!archive/deprecated/create_shortcut.py
!archive/deprecated/dashboard_app.py
!archive/deprecated/dashboard_qt.py
!archive/deprecated/dashboard_qt_final.py
!archive/deprecated/dashboard_qt_part2.py
!archive/deprecated/dashboard_qt_part3.py
!archive/deprecated/residual_engine.py
!archive/deprecated/secureguard.py